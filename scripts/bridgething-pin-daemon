#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PIN="$REPO_ROOT/meta-bridgething/recipes-core/bridgething-daemon/bridgething-daemon-pin.inc"

OTA_BASE="${BRIDGETHING_OTA_BASE:-https://ota.bridgething.com}"
CHANNEL="${BRIDGETHING_PIN_CHANNEL:-stable}"

log() { printf '\033[1;36m[pin-daemon]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[pin-daemon] error:\033[0m %s\n' "$*" >&2; exit 1; }

for cmd in curl jq shasum; do
  command -v "$cmd" >/dev/null 2>&1 || die "missing $cmd"
done
[ -f "$PIN" ] || die "no pin file at $PIN"

VERSION="${1:-}"
if [ -z "$VERSION" ]; then
  log "resolving the current $CHANNEL daemon from $OTA_BASE/manifest.json"
  VERSION=$(curl -fsS "$OTA_BASE/manifest.json" \
    | jq -r --arg ch "$CHANNEL" '.channels[$ch].latest // empty' \
    | sed -E 's/\+image\..*$//')
  [ -n "$VERSION" ] || die "could not resolve the $CHANNEL channel's latest daemon"
fi

URL="$OTA_BASE/daemon/$CHANNEL/$VERSION/bridgething"
TMP=$(mktemp -t bridgething-daemon-pin)
trap 'rm -f "$TMP"' EXIT

log "fetching $URL"
curl -fsS -o "$TMP" "$URL" \
  || die "no daemon binary at $URL; release it before pinning the image to it"

SHA=$(shasum -a 256 "$TMP" | awk '{print $1}')
SIZE=$(wc -c <"$TMP" | tr -d ' ')

DECLARED=$(curl -fsS "$OTA_BASE/manifest.json" 2>/dev/null \
  | jq -r --arg v "$VERSION" '[.releases[] | select(.version | startswith($v + "+image."))
                              | .artifacts.daemon.sha256] | first // empty' || true)
if [ -n "$DECLARED" ] && [ "$DECLARED" != "$SHA" ]; then
  log "WARNING: manifest declares ${DECLARED:0:12} for daemon $VERSION but R2 serves ${SHA:0:12}."
  log "         pinning what R2 serves. repair the manifest before cutting this image."
fi

OLD=$(sed -n 's/^BRIDGETHING_DAEMON_VERSION = "\([^"]*\)".*/\1/p' "$PIN")
sed -i.bak \
  -e "s|^BRIDGETHING_DAEMON_VERSION = \".*\"|BRIDGETHING_DAEMON_VERSION = \"$VERSION\"|" \
  -e "s|^BRIDGETHING_DAEMON_SHA256 = \".*\"|BRIDGETHING_DAEMON_SHA256 = \"$SHA\"|" \
  "$PIN"
rm -f "$PIN.bak"

log "pinned daemon ${OLD:-none} -> $VERSION ($SIZE bytes, ${SHA:0:12})"
log "$PIN"
