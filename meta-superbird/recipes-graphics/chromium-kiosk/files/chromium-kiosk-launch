#!/bin/sh
# chromium-kiosk-launch - exec cast_shell under weston as a kiosk.
#
# The kiosk runs cast_shell, the Chromecast Receiver content embedder
# (chromium 147 chromecast/ build target). cast_shell ships as
# /usr/lib/chromium/chromium-bin from the chromium-ozone-wayland
# recipe's cast-shell PACKAGECONFIG; the binary is materially smaller
# than chrome (~145 MB stripped vs ~273 MB), which is the fix for the
# squashfs page-fault storm under memory pressure that produced
# 9-second cold-of-kind animation latencies on this device.
#
# Sourced env file at /etc/default/chromium-kiosk lets vendors override
# KIOSK_URL and KIOSK_EXTRA without rebuilding the image. Build-time
# defaults come from the CHROMIUM_KIOSK_URL / CHROMIUM_KIOSK_PROXY_SERVER
# distro knobs (baked into the env file at install time).
#
# We cd into /usr/lib/chromium before exec so cast_shell's resource
# loader finds its paks (assets/cast_shell.pak, chromecast_locales/
# *.pak, icudtl.dat, snapshot_blob.bin) relative to cwd.
#
# CDP is unconditionally on at 9223, bound to 127.0.0.1. chromium >= M111
# silently ignores --remote-debugging-address=<non-localhost>, so the
# listener cannot be moved off loopback from here. kiosk-cdp-proxy fronts
# it on 9222 for off-device clients; it needs a port of its own because a
# 0.0.0.0 bind on 9223 would collide with this one. cast_shell's BUILD_ENG
# default UI-DevTools squat on 9223 is gated off by patch 0003.
#
# --remote-allow-origins=* is required because chromium rejects DevTools WS
# upgrades from non-localhost origins by default (chrome://inspect,
# devtools://devtools, and any IDE that initiates from a non-localhost
# Origin all hit a 403). The Origin header is set by the *initiating page*,
# not the TCP destination, so no amount of forwarding satisfies it.
#
# --use-angle=gles routes through Mesa's libGLESv2 -> libgallium ->
# Panfrost -> Mali-G31. chromium 147 only accepts (default | gles |
# vulkan | swiftshader); the chromium-wrapper's gles-egl value from
# meta-chromium's kiosk-mode PACKAGECONFIG is INVALID and would
# silently fall back to gl=disabled. We exec cast_shell directly
# (no wrapper) so we control the flag set wholesale.
#
# --single-process collapses every utility process (network, storage,
# on-device-model, GPU) and the renderer into the browser process.
# Trade-offs (well-reasoned for this kiosk):
#   1. Eliminates the network-service-as-utility-process Mojo IPC
#      heartbeat that previously timed out under cold-boot pressure
#      and parked the tab on about:blank. (With cast_shell's smaller
#      binary memory pressure is gone, but single-process is still
#      simpler.)
#   2. ~70 MB saved from per-process libc/page-table duplication.
#   3. No --renderer-process-limit=1 / --process-per-site complexity.
# Renderer-crash isolation is theatre on a single-site kiosk; only
# one tab, code is ours.
#
# --num-raster-threads=4 lets the raster thread pool fill all four
# A53 cores.
#
# --disable-low-end-device-mode is mandatory on this device. chromium's
# base::SysInfo::IsLowEndDevice() classifies any machine with under
# 512 MB of total RAM as "low-end" and switches the raster tile
# format from RGBA8888 to RGBA4444 (4 bits per channel) to halve tile
# memory. The Car Thing has ~426 MB usable, so without an explicit
# opt-out chromium picks RGBA4444 for any content-bearing tile and
# leaves uniform-fill tiles at full precision. The visual result is
# a horizontal seam wherever a paint region ends: content tiles
# render colors snapped to multiples of 0x11 (so #1B1F23 becomes
# #222222, the "off-white" #efefef becomes #eeeeee, etc.) while the
# uniform tiles next to them keep the exact CSS color. Confirmed by
# sweeping page-bg colors and watching the content half snap to the
# nearest 4-bit value while the empty half stays exact. The setting
# is the OFF switch for the auto-detected mode; --enable-low-end-
# device-mode would turn it on explicitly, and is intentionally not
# used (forces CPU rasterization, V8 lite-mode, smaller heaps - the
# perf hit dwarfs the tile-memory savings now that --single-process
# already trimmed ~70 MB).
#
# --js-flags is QUOTED. Without quotes, the shell word-splits the
# value and only the first inner flag reaches V8 - the prior version
# of this launcher passed --max-semi-space-size=4 unquoted, V8 never
# saw it, and the new generation ran at chromium's default size for
# years. Quote any future js-flags as one shell word.
#
# Niceness control lives in chromium-kiosk.service via
# CapabilityBoundingSet=~CAP_SYS_NICE + LimitNICE=20. Chromium calls
# setpriority(-8) on its UI / IO / GPU threads internally; on 4x A53
# those at -8 preempt kswapd and any other kernel work in the
# critical path of the renderer's own page faults. Stripping
# CAP_SYS_NICE makes setpriority return EPERM and the threads stay
# at nice=0.
#
# cast_shell resolves DIR_CAST_HOME from $HOME and keeps its whole browser
# context there: cookies, local storage, session storage, DIPS, shared
# storage. chromium-kiosk.service points HOME at a StateDirectory under
# /var/lib so that state survives reboots and A/B slot changes.
# --user-data-dir is a //chrome-layer switch that cast_shell never reads,
# so the profile location is HOME and nothing else.
#
# There is no HTTP disk cache to size or place: CastNetworkContexts::
# ConfigureDefaultNetworkContextParams hardcodes http_cache_enabled=false,
# so the profile carries no Code Cache or GPUCache either. The only
# persistent accelerator here is Mesa's shader cache under $HOME/.cache.
#
# --enable-zero-copy switches GPU texture upload from the default
# "CPU-side staging buffer + memcpy into GPU memory" path to a
# direct DMA buffer the GPU reads in place. On Mali-G31 / Panfrost
# CPU and GPU share physical RAM, so the staging copy is pure waste.
#
# --autoplay-policy=no-user-gesture-required permits HTMLMediaElement
# autoplay and Web Audio API audio context resume without a synthetic
# user gesture. The device has no audio output but webapps using Web
# Audio API for visualizations still need an unsuspended
# AudioContext.
#
# --disable-audio-output is load-bearing, not a testing flag. cast_shell
# links the stub libcast_media_1.0.so, whose CreateMediaPipelineBackend
# returns nullptr; the DCHECK guarding it compiles out in release, so the
# first CreateAudioDecoder dereferences null and the browser takes a SEGV.
# The switch makes CreateAudioManager hand back a FakeAudioManager so no
# output stream is ever built. Nothing is lost: the DT disables the whole
# TDM-B playback leg because the Car Thing has no speaker and those pads
# are the preset buttons, so ALSA exposes capture devices only. Combined
# with the autoplay policy above, without this any page carrying audio
# kills the kiosk on load.
#
# --enable-features=AcceleratedVideoDecoder routes video to meson-vdec through chromium's V4L2
# stateful decoder. The switch is all-or-nothing across codecs, so every codec the driver claims
# has to work: it needs chromium patch 0015, without which no decoded frame becomes a shared image
# and the lost GL context blacks the panel, plus kernel 0018 for the visible rect and 0019/0020 so
# H.264 and VP9 both advertise a capture format chromium considers renderable.
#
# Egress. KIOSK_PROXY_SERVER (bridgething uses socks5://127.0.0.1:1080 to
# tunnel webapp traffic over the companion phone) routes every byte
# chromium initiates; localhost stays DIRECT via the network stack's
# implicit bypass, so the local webapp bundle and websocket are unaffected.
# The switch only works because chromium patch 0012 layers a
# ProxyConfigServiceFixed under Cast's pref-only proxy tracker.
# What actually bounds egress is that proxy plus the absence of a default
# route: with no proxy reachable there is no path off the device at all.
# The --disable-features entries below trim content/-level background
# chatter; the //chrome-layer network switches do not exist in cast_shell.
#
# OverscrollHistoryNavigation is disabled by feature, not by switch. It is
# enabled by default and WebContentsViewAura installs a GestureNavSimple
# delegate for it, so a horizontal overscroll pops session history. Webapps
# here use horizontal swipe as a content gesture and route with the History
# API, so leaving it on lets a swipe navigate the app backwards.
#
# --cast-graphics-width=800 --cast-graphics-height=480 seed the
# CastScreen primary display via CastDisplayConfigurator's existing
# command-line path (chromecast/browser/cast_display_configurator.cc
# kCastGraphicsWidth / kCastGraphicsHeight). Without these flags the
# configurator falls back to GetDefaultScreenResolution() = 1280x720,
# CastContentWindowAura sizes the cast_shell wl_surface to that, and
# the actual panel (800x480 after weston's mode=480x800 transform=
# rotate-270) shows the compositor background because the wl_surface
# extents don't match what weston is presenting. With the right
# resolution the host bounds line up with the wl_output and the
# webapp renders to the panel. cast_core normally drives this through
# its runtime display bring-up, gated off by patch 0001.
#
# GPU compositing is enabled (no --disable-gpu-compositing). The viz
# Display compositor's final composite-to-output step uses the
# SkiaRenderer / OverlayProcessorOzone / GbmSurfacelessWayland /
# WaylandBufferManagerHost chain through ANGLE-GLES on Mesa-Panfrost on
# the Mali-G31. Patches 0006-0009 in the chromium bbappend together
# remove the four Cast-hardware assumptions that prevented this chain
# from completing on this device (set_fullscreen instead of set_maxi
# mized, opaque-black compositor backstop, no kDisableGpuEarlyInit
# default, ShouldCreatePrimaryPlane returns true even though IS_CASTOS).
# The wedge in 0009 was found via differential perfetto trace
# (--trace-startup=wayland,viz,gpu) - in the wedged build the
# OverlayProcessorOzone gates the root render pass out of the candidate
# list and the ScheduleOverlayPlane chain never runs, so no wl_buffer
# is ever attached to the wl_surface. With all four patches GPU
# compositing works and the device returns the 0.5-1.4 A53 cores that
# software composite was eating per workload.
#
# --enable-input is mandatory for cast_shell to deliver hardware input.
# Without it, CastWindowTreeHostAura::DispatchEvent early-returns on
# every ui::Event and the root window gets a NullWindowTargeter, so
# wl_touch dispatches from ozone-wayland arrive at the host but are
# dropped before any aura window sees them. CDP Input.dispatch* keeps
# working because it injects downstream of aura, at the render widget
# host. Cast's intent for the default-off behaviour is engineering
# builds that boot to a non-interactive splash before a runtime app
# takes over; this kiosk has no such second stage. Pairs with chromium
# patch 0010 which flips enable_touch_input on the CastWebViewParams
# so the (now-delivered) touch events also clear the TouchBlocker
# pre-target handler in CastContentWindowAura.

set -eu

if [ -r /etc/default/chromium-kiosk ]; then
    # shellcheck disable=SC1091
    . /etc/default/chromium-kiosk
fi
if [ -n "${KIOSK_ENV_OVERRIDE_FILE:-}" ] && [ -r "$KIOSK_ENV_OVERRIDE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$KIOSK_ENV_OVERRIDE_FILE"
fi

KIOSK_URL="${KIOSK_URL:-about:blank}"
KIOSK_EXTRA="${KIOSK_EXTRA:-}"
KIOSK_SINGLE_PROCESS="${KIOSK_SINGLE_PROCESS:-1}"
KIOSK_PROXY_SERVER="${KIOSK_PROXY_SERVER:-}"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/weston}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

if [ "${KIOSK_SINGLE_PROCESS}" = "1" ]; then
    SINGLE_PROCESS_FLAG=--single-process
else
    SINGLE_PROCESS_FLAG=
fi

if [ -n "$KIOSK_PROXY_SERVER" ]; then
    PROXY_SERVER_FLAG=--proxy-server="$KIOSK_PROXY_SERVER"
else
    PROXY_SERVER_FLAG=
fi

cd /usr/lib/chromium

# shellcheck disable=SC2086
exec ./chromium-bin \
    --no-sandbox \
    --ozone-platform=wayland \
    --use-angle=gles \
    --cast-graphics-width=800 \
    --cast-graphics-height=480 \
    --enable-input \
    --enable-wayland-ime \
    --wayland-text-input-version=1 \
    --allow-insecure-localhost \
    --noerrdialogs \
    --disable-pinch \
    --force-color-profile=srgb \
    ${SINGLE_PROCESS_FLAG} \
    --num-raster-threads=4 \
    --disable-low-end-device-mode \
    --enable-zero-copy \
    --autoplay-policy=no-user-gesture-required \
    --disable-audio-output \
    --enable-features=AcceleratedVideoDecoder \
    --js-flags="--max-old-space-size=192 --max-semi-space-size=16" \
    --disable-features=Translate,BackForwardCache,GlobalMediaControls,InterestFeedContentSuggestions,MediaRouter,MediaSessionService,OptimizationHints,OptimizationGuideModelDownloading,DialMediaRouteProvider,CalculateNativeWinOcclusion,AutofillServerCommunication,SafeBrowsing,NetworkTimeServiceQuerying,DnsOverHttps,FedCm,AcceptCHFrame,Reporting,OverscrollHistoryNavigation \
    ${PROXY_SERVER_FLAG} \
    --remote-debugging-port=9223 \
    --remote-allow-origins=* \
    ${KIOSK_EXTRA} \
    "${KIOSK_URL}"
