# /etc/default/kiosk-cdp-proxy - runtime overrides for the DevTools reverse proxy.
# Restart with `systemctl restart kiosk-cdp-proxy` to apply.
#
# The listen port must differ from the target port: chromium already holds the target on loopback,
# and a 0.0.0.0 bind on the same port would collide with it.
#
#   KIOSK_CDP_PROXY_LISTEN=0.0.0.0:9222
#   KIOSK_CDP_PROXY_TARGET=127.0.0.1:9223
