From 8b3f40c3996a6eed71fa8aeff5db562c93080c91 Mon Sep 17 00:00:00 2001
From: Neel Patel <108803410+68p@users.noreply.github.com>
Date: Wed, 19 Aug 2026 13:08:00 +0000
Subject: [PATCH] media: meson: vdec: fall back to FIFO timestamps for H.264

The Amlogic H.264 firmware occasionally reports an output byte offset which
precedes every outstanding ESPARSER timestamp.  The generic lookup then
completes the capture buffer with timestamp zero and leaves the oldest input
record accounted as queued.  GStreamer's V4L2 decoder cannot associate that
capture buffer with a codec frame, eventually reports "Too old frames", and
recycles capture buffers while the firmware still uses their pictures as H.264
references.  The visible result is persistent macroblock ghosting.

Wired CarPlay's low-latency H.264 stream is emitted in decode/display order.
More generally, once the firmware offset precedes all outstanding records the
offset association has already failed; completing H.264 from the oldest queued
record preserves ordering and buffer lifetime instead of manufacturing a zero
timestamp.  Make that recovery explicit and codec-selectable.  Enable it only
for H.264, retain the existing MPEG-1/2 behavior, and rate-limit the diagnostic.

This also removes and accounts the recovered timestamp record, preventing
esparser_queued_bufs from leaking on each offset miss.

Upstream-Status: Pending
Signed-off-by: Neel Patel <108803410+68p@users.noreply.github.com>
---
 drivers/staging/media/meson/vdec/codec_h264.c   |  3 ++-
 drivers/staging/media/meson/vdec/codec_mpeg12.c |  2 +-
 drivers/staging/media/meson/vdec/vdec_helpers.c | 17 ++++++++++++++---
 drivers/staging/media/meson/vdec/vdec_helpers.h | 10 ++++++----
 4 files changed, 23 insertions(+), 9 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/codec_h264.c b/drivers/staging/media/meson/vdec/codec_h264.c
index 1030b59..64151a5 100644
--- a/drivers/staging/media/meson/vdec/codec_h264.c
+++ b/drivers/staging/media/meson/vdec/codec_h264.c
@@ -413,7 +413,8 @@ static void codec_h264_frames_ready(struct amvdec_session *sess, u32 status)
 			field = V4L2_FIELD_INTERLACED_BT;
 
 		offset |= get_offset_msb(core, i);
-		amvdec_dst_buf_done_idx(sess, buffer_index, offset, field, vbuf_flags);
+		amvdec_dst_buf_done_idx(sess, buffer_index, offset, field,
+					vbuf_flags, true);
 	}
 }
 
diff --git a/drivers/staging/media/meson/vdec/codec_mpeg12.c b/drivers/staging/media/meson/vdec/codec_mpeg12.c
index 0f45eb4..c831025 100644
--- a/drivers/staging/media/meson/vdec/codec_mpeg12.c
+++ b/drivers/staging/media/meson/vdec/codec_mpeg12.c
@@ -187,7 +187,7 @@ static irqreturn_t codec_mpeg12_threaded_isr(struct amvdec_session *sess)
 	codec_mpeg12_update_dar(sess);
 	buffer_index = ((reg & 0xf) - 1) & 7;
 	offset = amvdec_read_dos(core, MREG_FRAME_OFFSET);
-	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field, 0);
+	amvdec_dst_buf_done_idx(sess, buffer_index, offset, field, 0, false);
 
 end:
 	amvdec_write_dos(core, MREG_BUFFEROUT, 0);
diff --git a/drivers/staging/media/meson/vdec/vdec_helpers.c b/drivers/staging/media/meson/vdec/vdec_helpers.c
index 6817394..1181368 100644
--- a/drivers/staging/media/meson/vdec/vdec_helpers.c
+++ b/drivers/staging/media/meson/vdec/vdec_helpers.c
@@ -367,7 +367,8 @@ EXPORT_SYMBOL_GPL(amvdec_dst_buf_done);
 void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
 				struct vb2_v4l2_buffer *vbuf,
 				u32 offset, u32 field, bool allow_drop,
-				u32 codec_flags)
+				u32 codec_flags,
+				bool allow_fifo_fallback)
 {
 	struct device *dev = sess->core->dev_dec;
 	struct amvdec_timestamp *match = NULL;
@@ -405,6 +406,14 @@ void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
 		}
 	}
 
+	if (!match && allow_fifo_fallback && !list_empty(&sess->timestamps)) {
+		match = list_first_entry(&sess->timestamps,
+					 struct amvdec_timestamp, list);
+		dev_warn_ratelimited(dev,
+			"Buffer %u can't match H.264 offset %08X; using FIFO offset %08X\n",
+			vbuf->vb2_buf.index, offset, match->offset);
+	}
+
 	if (!match) {
 		dev_err(dev, "Buffer %u done but can't match offset (%08X)\n",
 			vbuf->vb2_buf.index, offset);
@@ -426,7 +435,8 @@ EXPORT_SYMBOL_GPL(amvdec_dst_buf_done_offset);
 
 void amvdec_dst_buf_done_idx(struct amvdec_session *sess,
 			     u32 buf_idx, u32 offset, u32 field,
-			     u32 codec_flags)
+			     u32 codec_flags,
+			     bool allow_fifo_fallback)
 {
 	struct vb2_v4l2_buffer *vbuf;
 	struct device *dev = sess->core->dev_dec;
@@ -443,7 +453,8 @@ void amvdec_dst_buf_done_idx(struct amvdec_session *sess,
 
 	if (offset != -1)
 		amvdec_dst_buf_done_offset(sess, vbuf, offset, field, true,
-					   codec_flags);
+					   codec_flags,
+					   allow_fifo_fallback);
 	else
 		amvdec_dst_buf_done(sess, vbuf, field);
 }
diff --git a/drivers/staging/media/meson/vdec/vdec_helpers.h b/drivers/staging/media/meson/vdec/vdec_helpers.h
index 8be8699..fdfd707 100644
--- a/drivers/staging/media/meson/vdec/vdec_helpers.h
+++ b/drivers/staging/media/meson/vdec/vdec_helpers.h
@@ -39,15 +39,17 @@ u32 amvdec_am21c_size(u32 width, u32 height);
  * @offset: VIFIFO bitstream offset corresponding to the buffer
  * @field: V4L2 interlaced field
  * @codec_flags: additional V4L2 buffer flags reported by the codec
+ * @allow_fifo_fallback: recover an unmatched offset from the oldest timestamp
  */
 void amvdec_dst_buf_done_idx(struct amvdec_session *sess, u32 buf_idx,
-			     u32 offset, u32 field, u32 codec_flags);
+			     u32 offset, u32 field,
+			     u32 codec_flags, bool allow_fifo_fallback);
 void amvdec_dst_buf_done(struct amvdec_session *sess,
 			 struct vb2_v4l2_buffer *vbuf, u32 field);
 void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
 				struct vb2_v4l2_buffer *vbuf,
 				u32 offset, u32 field, bool allow_drop,
-				u32 codec_flags);
+				u32 codec_flags, bool allow_fifo_fallback);
 
 /**
  * amvdec_add_ts() - Add a timestamp to the list
-- 
2.53.0
