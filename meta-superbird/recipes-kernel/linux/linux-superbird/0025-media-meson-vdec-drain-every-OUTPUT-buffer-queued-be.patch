From 67ba6179314074c5cc07bcb973e7188c56d2881d Mon Sep 17 00:00:00 2001
From: Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com>
Date: Fri, 9 Oct 2026 15:45:00 -0400
Subject: [PATCH] media: meson: vdec: drain every OUTPUT buffer queued before
 DEC_CMD_STOP

The stateful decoder drain sequence requires every OUTPUT buffer queued
before V4L2_DEC_CMD_STOP to be decoded before the CAPTURE buffer flagged
V4L2_BUF_FLAG_LAST is returned. meson-vdec does not honor that.

OUTPUT buffers reach the ESPARSER asynchronously from
esparser_queue_all_src(), and buffers can sit in the m2m ready queue for
a while: the work item has not run yet, or the VP9 path is holding input
back until CAPTURE buffers return. DEC_CMD_STOP set should_stop straight
away, which stopped that work from feeding anything still queued, queued
the H.264 end-of-stream sequence ahead of that input, and armed LAST on
the first picture that left at most one parsed packet outstanding. The
buffers still queued were not parsed until after LAST had gone out, and
a client that waits for its queued OUTPUT buffers before finishing the
drain never finishes. Chromium does exactly that: with a looping <video>
it issues DEC_CMD_STOP right after queueing the last packet, and
playback froze three frames short of the end.

DEC_CMD_START had two further problems. It never cleared the CAPTURE
queue's last_buffer_dequeued, so after a completed drain every DQBUF
returned -EPIPE and poll() reported EPOLLIN forever. Chromium busy-loops
on that: over half a million DQBUF calls in 30 seconds on a stalled
pass. It was also accepted while a drain was still running.

Track the drain as an explicit state machine:

 - DEC_CMD_STOP records how many OUTPUT buffers are still queued and
   lets the ESPARSER work feed exactly those. Later buffers are held
   until the decoder restarts.
 - Once they are parsed, the work arms LAST for the picture that
   retires the last outstanding timestamp, then queues the codec
   end-of-stream sequence and runs the codec drain. Completions now
   retire their timestamp before testing for LAST, and that test and
   the arming both read the counter under ts_spinlock, so a final
   picture racing the arming is flagged exactly once, either itself or
   through an empty LAST buffer.
 - If nothing is outstanding at that point, an empty CAPTURE buffer is
   returned flagged LAST, or the next one queued is.
 - The codec drain waits for the decoder to go idle without holding the
   session lock, so queue ioctls are not stalled meanwhile.
 - DEC_CMD_START and DEC_CMD_STOP return -EBUSY while a drain is in
   progress; DEC_CMD_START after a drain clears last_buffer_dequeued and
   resumes feeding.

DEC_CMD_STOP now also serializes with the ESPARSER work through the
session lock instead of writing to the parser concurrently with it.

After an H.264 drain the firmware does not decode new input until the
session is restarted with VIDIOC_STREAMOFF and VIDIOC_STREAMON, so a
client that continues after DEC_CMD_START still needs that restart for
H.264. VP9 resumes decoding after DEC_CMD_START.

Upstream-Status: Pending
Signed-off-by: Joey Eamigh <55670930+JoeyEamigh@users.noreply.github.com>
---
 drivers/staging/media/meson/vdec/esparser.c   |  15 +-
 drivers/staging/media/meson/vdec/vdec.c       | 143 +++++++++++++++---
 drivers/staging/media/meson/vdec/vdec.h       |  29 +++-
 .../staging/media/meson/vdec/vdec_helpers.c   |  28 +++-
 4 files changed, 179 insertions(+), 36 deletions(-)

diff --git a/drivers/staging/media/meson/vdec/esparser.c b/drivers/staging/media/meson/vdec/esparser.c
index 793cbfd34..f4d5e798a 100644
--- a/drivers/staging/media/meson/vdec/esparser.c
+++ b/drivers/staging/media/meson/vdec/esparser.c
@@ -379,15 +379,26 @@ void esparser_queue_all_src(struct work_struct *work)
 	struct v4l2_m2m_buffer *buf, *n;
 	struct amvdec_session *sess =
 		container_of(work, struct amvdec_session, esparser_queue_work);
+	int ret;
 
 	mutex_lock(&sess->lock);
 	v4l2_m2m_for_each_src_buf_safe(sess->m2m_ctx, buf, n) {
-		if (sess->should_stop)
+		if (sess->drain != DRAIN_NONE && !sess->drain_src_bufs)
 			break;
 
-		if (esparser_queue(sess, &buf->vb) < 0)
+		ret = esparser_queue(sess, &buf->vb);
+		if (ret == -EAGAIN)
+			break;
+
+		if (sess->drain_src_bufs)
+			sess->drain_src_bufs--;
+
+		if (ret < 0)
 			break;
 	}
+
+	if (sess->drain == DRAIN_FEEDING && !sess->drain_src_bufs)
+		amvdec_drain_input_done(sess);
 	mutex_unlock(&sess->lock);
 }
 
diff --git a/drivers/staging/media/meson/vdec/vdec.c b/drivers/staging/media/meson/vdec/vdec.c
index a2bdc9f11..77b6376e1 100644
--- a/drivers/staging/media/meson/vdec/vdec.c
+++ b/drivers/staging/media/meson/vdec/vdec.c
@@ -119,12 +119,22 @@ static void vdec_wait_inactive(struct amvdec_session *sess)
 		msleep(25);
 }
 
+static void vdec_set_drain(struct amvdec_session *sess,
+			   enum amvdec_drain drain)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	sess->drain = drain;
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+}
+
 static void vdec_poweroff(struct amvdec_session *sess)
 {
 	struct amvdec_ops *vdec_ops = sess->fmt_out->vdec_ops;
 	struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
 
-	sess->should_stop = 1;
+	vdec_set_drain(sess, DRAIN_STOPPED);
 	vdec_wait_inactive(sess);
 	if (codec_ops->drain)
 		codec_ops->drain(sess);
@@ -149,6 +159,80 @@ vdec_queue_recycle(struct amvdec_session *sess, struct vb2_buffer *vb)
 	mutex_unlock(&sess->bufs_recycle_lock);
 }
 
+static void
+vdec_unqueue_recycle(struct amvdec_session *sess, struct vb2_buffer *vb)
+{
+	struct amvdec_buffer *tmp, *n;
+
+	mutex_lock(&sess->bufs_recycle_lock);
+	list_for_each_entry_safe(tmp, n, &sess->bufs_recycle, list) {
+		if (tmp->vb != vb)
+			continue;
+
+		list_del(&tmp->list);
+		kfree(tmp);
+	}
+	mutex_unlock(&sess->bufs_recycle_lock);
+}
+
+static void vdec_dst_buf_last(struct amvdec_session *sess,
+			      struct vb2_v4l2_buffer *vbuf)
+{
+	static const struct v4l2_event ev = { .type = V4L2_EVENT_EOS };
+	unsigned int i;
+
+	vdec_unqueue_recycle(sess, &vbuf->vb2_buf);
+	for (i = 0; i < vbuf->vb2_buf.num_planes; i++)
+		vb2_set_plane_payload(&vbuf->vb2_buf, i, 0);
+
+	vbuf->field = V4L2_FIELD_NONE;
+	vbuf->flags = V4L2_BUF_FLAG_LAST;
+	vbuf->sequence = sess->sequence_cap++;
+	vdec_set_drain(sess, DRAIN_STOPPED);
+
+	v4l2_event_queue_fh(&sess->fh, &ev);
+	v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
+}
+
+void amvdec_drain_input_done(struct amvdec_session *sess)
+{
+	struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
+	struct vb2_v4l2_buffer *vbuf;
+	unsigned long flags;
+	bool idle;
+
+	lockdep_assert_held(&sess->lock);
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	idle = !atomic_read(&sess->esparser_queued_bufs);
+	sess->drain = idle ? DRAIN_LAST_OWED : DRAIN_ARMED;
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+
+	if (idle) {
+		vbuf = v4l2_m2m_dst_buf_remove(sess->m2m_ctx);
+		if (vbuf)
+			vdec_dst_buf_last(sess, vbuf);
+		return;
+	}
+
+	if (codec_ops->eos_sequence) {
+		u32 len;
+		const u8 *data = codec_ops->eos_sequence(&len);
+
+		esparser_queue_eos(sess, data, len);
+	}
+
+	if (!codec_ops->drain)
+		return;
+
+	mutex_unlock(&sess->lock);
+	vdec_wait_inactive(sess);
+	mutex_lock(&sess->lock);
+
+	if (sess->drain == DRAIN_ARMED)
+		codec_ops->drain(sess);
+}
+
 static void vdec_m2m_device_run(void *priv)
 {
 	struct amvdec_session *sess = priv;
@@ -282,6 +366,12 @@ static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 	struct amvdec_session *sess = vb2_get_drv_priv(vb->vb2_queue);
 	struct v4l2_m2m_ctx *m2m_ctx = sess->m2m_ctx;
 
+	if (vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+	    sess->drain == DRAIN_LAST_OWED) {
+		vdec_dst_buf_last(sess, vbuf);
+		return;
+	}
+
 	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
 
 	if (!sess->streamon_out)
@@ -339,7 +429,8 @@ static int vdec_start_streaming(struct vb2_queue *q, unsigned int count)
 		goto bufs_done;
 	}
 
-	sess->should_stop = 0;
+	vdec_set_drain(sess, DRAIN_NONE);
+	sess->drain_src_bufs = 0;
 	sess->keyframe_found = 0;
 	sess->last_offset = 0;
 	sess->wrap_count = 0;
@@ -741,7 +832,6 @@ static int
 vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 {
 	struct amvdec_session *sess = file_to_amvdec_session(file);
-	struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
 	struct device *dev = sess->core->dev;
 	int ret;
 
@@ -752,32 +842,41 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 	if (!(sess->streamon_out & sess->streamon_cap))
 		return 0;
 
-	if (cmd->cmd == V4L2_DEC_CMD_START) {
-		v4l2_m2m_clear_state(sess->m2m_ctx);
-		sess->should_stop = 0;
-		return 0;
-	}
+	mutex_lock(&sess->lock);
 
-	/* Should not happen */
-	if (cmd->cmd != V4L2_DEC_CMD_STOP)
-		return -EINVAL;
-
-	dev_dbg(dev, "Received V4L2_DEC_CMD_STOP\n");
+	switch (cmd->cmd) {
+	case V4L2_DEC_CMD_START:
+		if (sess->drain == DRAIN_NONE)
+			break;
 
-	sess->should_stop = 1;
+		if (sess->drain != DRAIN_STOPPED) {
+			ret = -EBUSY;
+			break;
+		}
 
-	v4l2_m2m_mark_stopped(sess->m2m_ctx);
+		vdec_set_drain(sess, DRAIN_NONE);
+		vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(sess->m2m_ctx));
+		schedule_work(&sess->esparser_queue_work);
+		break;
+	case V4L2_DEC_CMD_STOP:
+		if (sess->drain == DRAIN_STOPPED)
+			break;
 
-	if (codec_ops->eos_sequence) {
-		u32 len;
-		const u8 *data = codec_ops->eos_sequence(&len);
+		if (sess->drain != DRAIN_NONE) {
+			ret = -EBUSY;
+			break;
+		}
 
-		esparser_queue_eos(sess, data, len);
+		dev_dbg(dev, "Received V4L2_DEC_CMD_STOP\n");
+		sess->drain_src_bufs = v4l2_m2m_num_src_bufs_ready(sess->m2m_ctx);
+		vdec_set_drain(sess, DRAIN_FEEDING);
+		schedule_work(&sess->esparser_queue_work);
+		break;
+	default:
+		ret = -EINVAL;
 	}
 
-	vdec_wait_inactive(sess);
-	if (codec_ops->drain)
-		codec_ops->drain(sess);
+	mutex_unlock(&sess->lock);
 
 	return ret;
 }
diff --git a/drivers/staging/media/meson/vdec/vdec.h b/drivers/staging/media/meson/vdec/vdec.h
index b22f169f8..ad2ea7166 100644
--- a/drivers/staging/media/meson/vdec/vdec.h
+++ b/drivers/staging/media/meson/vdec/vdec.h
@@ -178,6 +178,23 @@ enum amvdec_status {
 	STATUS_NEEDS_RESUME,
 };
 
+/**
+ * enum amvdec_drain - V4L2_DEC_CMD_STOP drain sequence state
+ *
+ * @DRAIN_NONE: decoding normally
+ * @DRAIN_FEEDING: OUTPUT buffers queued before the stop are still being parsed
+ * @DRAIN_ARMED: all input parsed, the picture retiring the last timestamp is LAST
+ * @DRAIN_LAST_OWED: nothing left to decode, the next CAPTURE buffer is an empty LAST
+ * @DRAIN_STOPPED: LAST returned or session torn down, OUTPUT is held until restart
+ */
+enum amvdec_drain {
+	DRAIN_NONE,
+	DRAIN_FEEDING,
+	DRAIN_ARMED,
+	DRAIN_LAST_OWED,
+	DRAIN_STOPPED,
+};
+
 /**
  * struct amvdec_session - decoding session parameters
  *
@@ -204,8 +221,8 @@ enum amvdec_status {
  * @streamon_out: stream on flag for output queue
  * @sequence_cap: capture sequence counter
  * @sequence_out: output sequence counter
- * @should_stop: flag set if userspace signaled EOS via command
- *		 or empty buffer
+ * @drain: drain sequence state, written under @ts_spinlock
+ * @drain_src_bufs: OUTPUT buffers queued before the drain still to be parsed
  * @keyframe_found: flag set once a keyframe has been parsed
  * @num_dst_bufs: number of destination buffers
  * @changed_format: the format changed
@@ -218,7 +235,7 @@ enum amvdec_status {
  * @bufs_recycle_lock: lock for the bufs_recycle list
  * @recycle_thread: task struct for the recycling thread
  * @timestamps: chronological list of src timestamps
- * @ts_spinlock: spinlock for the timestamps list
+ * @ts_spinlock: spinlock for the timestamps list and the drain state
  * @last_activity_jiffies: tracks the last vdec IRQ or ESPARSER write
  * @last_offset: tracks last offset of vififo
  * @wrap_count: number of times the vififo wrapped around
@@ -254,7 +271,8 @@ struct amvdec_session {
 
 	unsigned int streamon_cap, streamon_out;
 	unsigned int sequence_cap, sequence_out;
-	unsigned int should_stop;
+	enum amvdec_drain drain;
+	unsigned int drain_src_bufs;
 	unsigned int keyframe_found;
 	unsigned int num_dst_bufs;
 	unsigned int changed_format;
@@ -271,7 +289,7 @@ struct amvdec_session {
 	struct task_struct *recycle_thread;
 
 	struct list_head timestamps;
-	spinlock_t ts_spinlock; /* timestamp list lock */
+	spinlock_t ts_spinlock; /* timestamp list and drain state lock */
 
 	u64 last_activity_jiffies;
 	u32 last_offset;
@@ -289,5 +307,6 @@ static inline struct amvdec_session *file_to_amvdec_session(struct file *filp)
 
 u32 amvdec_get_output_size(struct amvdec_session *sess);
 u32 amvdec_get_luma_size(struct amvdec_session *sess);
+void amvdec_drain_input_done(struct amvdec_session *sess);
 
 #endif
diff --git a/drivers/staging/media/meson/vdec/vdec_helpers.c b/drivers/staging/media/meson/vdec/vdec_helpers.c
index 118136885..2f473db96 100644
--- a/drivers/staging/media/meson/vdec/vdec_helpers.c
+++ b/drivers/staging/media/meson/vdec/vdec_helpers.c
@@ -276,6 +276,21 @@ void amvdec_remove_ts(struct amvdec_session *sess, u64 ts)
 }
 EXPORT_SYMBOL_GPL(amvdec_remove_ts);
 
+static bool amvdec_drain_last(struct amvdec_session *sess)
+{
+	unsigned long flags;
+	bool last;
+
+	spin_lock_irqsave(&sess->ts_spinlock, flags);
+	last = sess->drain == DRAIN_ARMED &&
+	       !atomic_read(&sess->esparser_queued_bufs);
+	if (last)
+		sess->drain = DRAIN_STOPPED;
+	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
+
+	return last;
+}
+
 static void dst_buf_done(struct amvdec_session *sess,
 			 struct vb2_v4l2_buffer *vbuf,
 			 u32 field, u64 timestamp,
@@ -305,8 +320,7 @@ static void dst_buf_done(struct amvdec_session *sess,
 	vbuf->flags = flags;
 	vbuf->timecode = timecode;
 
-	if (sess->should_stop &&
-	    atomic_read(&sess->esparser_queued_bufs) <= 1) {
+	if (amvdec_drain_last(sess)) {
 		const struct v4l2_event ev = { .type = V4L2_EVENT_EOS };
 
 		dev_dbg(dev, "Signaling EOS, sequence_cap = %u\n",
@@ -317,8 +331,8 @@ static void dst_buf_done(struct amvdec_session *sess,
 		/* Mark LAST for drained show frames during a source change */
 		vbuf->flags |= V4L2_BUF_FLAG_LAST;
 		sess->sequence_cap = 0;
-	} else if (sess->should_stop)
-		dev_dbg(dev, "should_stop, %u bufs remain\n",
+	} else if (sess->drain != DRAIN_NONE)
+		dev_dbg(dev, "draining, %u bufs remain\n",
 			atomic_read(&sess->esparser_queued_bufs));
 
 	dev_dbg(dev, "Buffer %u done, ts = %llu, flags = %08X\n",
@@ -359,8 +373,8 @@ void amvdec_dst_buf_done(struct amvdec_session *sess,
 	kfree(tmp);
 	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
 
-	dst_buf_done(sess, vbuf, field, timestamp, timecode, vbuf_flags);
 	atomic_dec(&sess->esparser_queued_bufs);
+	dst_buf_done(sess, vbuf, field, timestamp, timecode, vbuf_flags);
 }
 EXPORT_SYMBOL_GPL(amvdec_dst_buf_done);
 
@@ -426,10 +440,10 @@ void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
 	}
 	spin_unlock_irqrestore(&sess->ts_spinlock, flags);
 
-	dst_buf_done(sess, vbuf, field, timestamp, timecode,
-		     vbuf_flags | codec_flags);
 	if (match)
 		atomic_dec(&sess->esparser_queued_bufs);
+	dst_buf_done(sess, vbuf, field, timestamp, timecode,
+		     vbuf_flags | codec_flags);
 }
 EXPORT_SYMBOL_GPL(amvdec_dst_buf_done_offset);
 
