#!/bin/sh
# once systemd gives up on the daemon, promote the previous bandaid daemon; with none, wipe bandaid and reboot to factory.
set -eu

BANDAID_VENDOR=/var/lib/bandaid/bridgething
DAEMON_DIR=${BANDAID_VENDOR}/daemon
CURRENT=${DAEMON_DIR}/bridgething.current
PREVIOUS=${DAEMON_DIR}/bridgething.previous

if [ ! -d "$BANDAID_VENDOR" ]; then
    exit 0
fi

if [ -n "$(systemctl show -p Job --value bridgething.service)" ]; then
    exit 0
fi
case "$(systemctl show -p ActiveState --value bridgething.service)" in
    active|activating|reloading) exit 0 ;;
esac

if [ -e "$PREVIOUS" ]; then
    rm -f "$CURRENT"
    mv "$PREVIOUS" "$CURRENT"

    systemctl reset-failed bridgething.service
    systemctl start bridgething.service
    exit 0
fi

rm -rf "${BANDAID_VENDOR}"
sync
systemctl reboot
