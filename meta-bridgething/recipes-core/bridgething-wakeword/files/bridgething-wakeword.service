[Unit]
Description=Bridgething wakeword detector
Documentation=https://github.com/JoeyEamigh/bridgething

[Service]
Type=simple
Environment=RUST_LOG=info

ExecStartPre=/bin/sh -c 'install -d /var/bridgething/wakeword; \
    [ -f /var/bridgething/wakeword/hey_bridgething.onnx ] || \
    install -m 0644 /usr/share/bridgething-wakeword/hey_bridgething.onnx \
        /var/bridgething/wakeword/hey_bridgething.onnx'

ExecStart=/usr/share/bridgething-wakeword/bridgething-wakeword \
    /run/bridgething-wakeword.sock \
    /usr/share/bridgething-wakeword \
    /var/bridgething/wakeword/hey_bridgething.onnx \
    0.5
ExecStopPost=-/bin/rm -f /run/bridgething-wakeword.sock

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
